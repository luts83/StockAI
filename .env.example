# ── AI ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── MongoDB Atlas ───────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=stockai
MONGODB_DB=stockai

# ── Auth (Google OAuth) ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SECRET_KEY=change-me-to-a-long-random-string

# ── Admin ───────────────────────────────────────────
# 콤마로 여러 이메일 가능
ADMIN_EMAIL=

# ── Optional ────────────────────────────────────────
INSTAGRAM_HANDLE=@stockai_kr
# PORT=8000
